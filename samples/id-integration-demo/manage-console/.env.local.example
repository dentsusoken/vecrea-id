# 開発用: true にすると Cognito 認証をスキップ（本番では設定しない）
# SKIP_AUTH=true

# Cognito (コンソールログイン用)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# OAuth2.0 Client Credentials (バックエンドAPI用アクセストークン)
OAUTH_TOKEN_ENDPOINT=https://your-auth-server/oauth2/token
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_SCOPE=manage:users:read manage:users:write manage:users:delete manage:users:import

# バックエンドAPI
API_BASE_URL=https://dkm0753qll.execute-api.ap-northeast-1.amazonaws.com/v1/api/manage
