{
  "name": "@vecrea/cognito-sdk",
  "version": "0.0.0",
  "description": "A generic SDK wrapping AWS Cognito, making it easier to use.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./admin": {
      "types": "./dist/admin.d.mts",
      "import": "./dist/admin.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1044.0"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260506.1",
    "bumpp": "^11.0.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "peerDependencies": {
    "@simplewebauthn/browser": "^13.3.0"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.1.3"
}
